  if (L && h > L.hTop - 1) { const a = Math.atan2(L.z, L.x), al = x * Math.cos(a) + z * Math.sin(a), lat = Math.abs(-x * Math.sin(a) + z * Math.cos(a)); if (al > 9.3 && al < Ri(L.hTop) + 0.45 && lat < 0.75) return 'metal'; }
  const rm = roomAt(x, z, h); if (rm && rm.id !== 'central') return 'wood'; if (r < 21 && rm && rm.id === 'central') return h > 0.15 ? 'concrete' : 'marble'; return 'stone'; });
//#endif

const ray = new THREE.Raycaster();
function aimHit() {
  camera.updateMatrixWorld(); ray.setFromCamera(new THREE.Vector2(0, 0), camera);
  return ray.intersectObjects(hitTargets(), false)[0];
}
//#if play
function fire() { /* museum-move hold 2026-10-18 */ if (chaosActive) return; if (tools && tools.owns(weapon)) { tools.down(weapon); return; } if (swarm && swarm.locked) return; if (weapon === 2) { if (grav) grav.primary(); return; } recoil = 1; if (weapon === 0) fling = FLING_TIME; weapon === 0 ? throwSoup() : buy(); }
//#elif orsay bilbao uffizi gugg-ny splat
