  L0.groupSigns = (L0.groupSigns || []).filter(s => s.anchor && s.anchor.id !== 'friends-club-mural').map(s => { const p = s.anchor; return { ...s, x: p.x + p.ix * 0.02, z: p.z + p.iz * 0.02, y: Math.max(3.2, p.y + p.fh / 2 + 0.35), yaw: Math.atan2(p.ix, p.iz) }; });
  { const seen = new Set(); L0.groupSigns = L0.groupSigns.filter(s => { const k = s.x.toFixed(1) + s.z.toFixed(1); if (seen.has(k)) return false; seen.add(k); return true; }); } }
{ const st = CATALOG.layout.start; camera.position.set(st.x, 1.6, st.z); camera.lookAt(st.x + Math.sin(st.yaw) * 5, 1.6, st.z + Math.cos(st.yaw) * 5); }
