let clockT = 0, ride = null, rideCool = 0;
// glass elevators: step into a cab and it carries you up to the level-3 bridges and back down (the engine has one walkable floor,
// so the upper levels are seen from the ride rather than walked)
function updateLifts(dt) {
  rideCool = Math.max(0, rideCool - dt);
  if (!ride && !chaosActive && !fall && rideCool === 0) for (const l of NAVE.lifts) if (Math.hypot(camera.position.x - l.x, camera.position.z - l.z) < 0.75) { ride = { l, t: 0, t0: performance.now(), x: l.x, z: l.z }; say('GLASS ELEVATOR · UP TO LEVEL 3', 3); break; }
  if (!ride) return; ride.t = (performance.now() - ride.t0) / 1000; const T = ride.t, // wall-clock, so slow frames don't stretch the ride
    up = 7, hold = 6, h = T < up ? 19.5 * (0.5 - 0.5 * Math.cos(Math.PI * T / up)) : T < up + hold ? 19.5 : T < 2 * up + hold ? 19.5 * (0.5 + 0.5 * Math.cos(Math.PI * (T - up - hold) / up)) : 0;
  if (Math.abs(T - up) < dt) say('LEVEL 3 · THE FLOWER IS ABOVE YOU', 3);
  ride.l.cab.position.y = h; camera.position.x = ride.x; camera.position.z = ride.z; camera.position.y = EYE + h; vel.set(0, 0, 0);
  if (T >= 2 * up + hold) { ride.l.cab.position.y = 0; camera.position.y = EYE; ride = null; rideCool = 4; camera.position.x += 1.4; } }
