//#endif
let leaving = false;
function saveState() { try { sessionStorage.setItem('tjmPlayState', JSON.stringify({ pos: camera.position.toArray(), quat: camera.quaternion.toArray(), weapon, cart: cart.map(c => c.slug), swarmCount, at: Date.now() })); } catch (e) {} }
function goCheckout() {
  if (leaving) return; leaving = true;
  // save a spot 1.6 m in front of the gate, facing it, so "Back to the Dungeon" resumes there
  const back = CHK.pos.clone().addScaledVector(CHK.n, 1.6); back.y = EYE; camera.position.copy(back); camera.lookAt(CHK.pos.x, EYE, CHK.pos.z); saveState();
  // same cart the site uses (payments/cart.js: localStorage 'va-cart-v1', [{id, quantity}] with id = product slug)
  try { const cur = JSON.parse(localStorage.getItem('va-cart-v1') || '[]'), ids = new Set((Array.isArray(cur) ? cur : []).map(i => i.id));
    const add = cart.filter(d => d.status === 'available' && !ids.has(d.slug)).map(d => ({ id: d.slug, quantity: 1 }));
    localStorage.setItem('va-cart-v1', JSON.stringify([...(Array.isArray(cur) ? cur : []), ...add].slice(0, 12))); } catch (e) {}
  teleSound(); say('TO THE CHECKOUT…', 3); if (controls.isLocked) controls.unlock();
  const onSite = /(^|\.)tjm\.art$/.test(location.hostname);
  const ids = cart.filter(d => d.status === 'available').map(d => d.slug).slice(0, 12); // off-site: carry the picks to the tjm.art cart
  const url = onSite ? '/cart/?from=play' : 'https://tjm.art/play/to-cart.html?from=play&items=' + encodeURIComponent(ids.join(',')); window.__checkoutGo = url; // tests stub navigation with __noNav
  if (!window.__noNav) setTimeout(() => top.location.assign(url), 600);
}
window.__goCheckout = () => goCheckout(); // #236: the guide bot's 'Take me to checkout' run ends here (also when the gate is out of reach, e.g. the splat rooms)
let audioCtx = null;
function teleSound() { // synthesized Quake-ish teleport whoosh
  if (window.game && game.holo && game.holo.muted) return; // silent when muted (#236)
  try { audioCtx = audioCtx || new (window.AudioContext || window.webkitAudioContext)(); const a = audioCtx, t = a.currentTime;
    const o = a.createOscillator(), g = a.createGain(); o.type = 'sawtooth'; o.frequency.setValueAtTime(880, t); o.frequency.exponentialRampToValueAtTime(55, t + 0.9);
    g.gain.setValueAtTime(0.25, t); g.gain.exponentialRampToValueAtTime(0.001, t + 1); o.connect(g).connect(a.destination); o.start(t); o.stop(t + 1);
    const b = a.createBuffer(1, a.sampleRate, a.sampleRate), d = b.getChannelData(0); for (let i = 0; i < d.length; i++) d[i] = (Math.random() * 2 - 1) * (1 - i / d.length);
    const ns = a.createBufferSource(), ng = a.createGain(); ns.buffer = b; ng.gain.value = 0.18; ns.connect(ng).connect(a.destination); ns.start(t); } catch (e) {}
}
let fall = null;
function enterGate() {
  const back = GATE.pos.clone().addScaledVector(GATE.n, 1.6); back.y = EYE;
  const q = camera.clone(); q.position.copy(back); q.lookAt(back.x + GATE.n.x, EYE, back.z + GATE.n.z); // facing away from the gate
  fall = { v: 0, back, backQ: q.quaternion.clone(), t: 0 };
  teleSound(); controls.enabled = false; vel.set(0, 0, 0);
