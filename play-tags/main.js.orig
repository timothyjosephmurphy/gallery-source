const isTouch = matchMedia('(pointer:coarse)').matches, standalone = matchMedia('(display-mode: fullscreen), (display-mode: standalone)').matches || navigator.standalone;
function goFullscreen() {
  if (!isTouch || standalone) return;
  const el = document.documentElement, rq = el.requestFullscreen || el.webkitRequestFullscreen || el.webkitRequestFullScreen || el.msRequestFullscreen;
  if (rq && !(document.fullscreenElement || document.webkitFullscreenElement)) {
    try { const r = rq.call(el, { navigationUI: 'hide' }); if (r && r.then) r.then(lockLandscape, () => {}); else lockLandscape(); } catch (e) {}
  } else if (!rq) { // iPhone Safari: nudge the toolbar away and suggest Add to Home Screen once
    window.scrollTo(0, 1);
    try { if (!localStorage.getItem('tjmIosHint')) { localStorage.setItem('tjmIosHint', '1'); const hnt = document.getElementById('iosHint'); hnt.hidden = false; hnt.querySelector('button').onclick = () => hnt.hidden = true; setTimeout(() => hnt.hidden = true, 9000); } } catch (e) {}
  }
}
{ const r = document.getElementById('rotate'); if (r) { const b = document.createElement('button'); b.type = 'button'; b.id = 'portraitok'; b.textContent = 'Play in portrait anyway';
  try { if (sessionStorage.getItem('tjmPortraitOk') === '1') document.body.classList.add('portraitok'); } catch (e) {}
  ['touchstart', 'touchend', 'mousedown'].forEach(ev => b.addEventListener(ev, e => e.stopPropagation()));
  b.addEventListener('click', e => { e.stopPropagation(); document.body.classList.add('portraitok'); try { sessionStorage.setItem('tjmPortraitOk', '1'); } catch (x) {} }); r.appendChild(b);
  const rl = document.createElement('small'); rl.className = 'rl'; rl.textContent = 'Phone will not turn? Rotation lock may be on. Portrait starts by itself in a moment.'; r.appendChild(rl);
  setTimeout(() => document.body.classList.add('portraitok'), 3000); } } // #208: never leave a phone stuck behind the overlay
function lockLandscape() { try { screen.orientation && screen.orientation.lock && screen.orientation.lock('landscape').catch(() => {}); } catch (e) {} }
