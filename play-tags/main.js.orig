  x.fillStyle = subColor || '#4a3f32'; x.font = '32px Arial, sans-serif'; x.fillText(fit(x, sub, textW), 18, 112);
  if (sold) { x.fillStyle = '#c8211b'; x.beginPath(); x.arc(484, 80, 14, 0, Math.PI * 2); x.fill(); }
  const m = new THREE.Mesh(unit, new THREE.MeshBasicMaterial({ map: sharp(new THREE.CanvasTexture(c)) })); m.scale.set(PLAQUE_W, PLAQUE_H, 1); exempt(m); return m;
}
