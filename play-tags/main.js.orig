// a wall along one side of a room, cut by doorway openings
function wall(room, side) {
  const horiz = side === 'N' || side === 'S';
  const c = side === 'N' ? room.maxZ : side === 'S' ? room.minZ : side === 'W' ? room.minX : room.maxX;
  const a0 = horiz ? room.minX : room.minZ, a1 = horiz ? room.maxX : room.maxZ;
