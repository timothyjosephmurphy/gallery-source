import { createChaos } from './chaos.js';
import { makeElf, animateElf, elfUniforms, tickElfMaterials } from './elves3d.js';
import { trackSplat, splatLog } from './splatlog.js';
import { smoothStoneCanvas } from './pixels.js';
import { makeHolos } from './holo.js';
import { makeBooks } from './books.js';
//#if play
//#elif orsay
import { buildNave } from './orsay.js';
import { rehang } from './rehang.js';
//#elif bilbao
import { buildBilbao, waveCeiling } from './bilbao.js';
import { rehang } from './rehang.js';
//#elif uffizi
import { buildUffizi } from './uffizi.js'; // Uffizi: Tribuna hub + U of corridors
import { rehang } from './rehang.js';
//#elif gugg-ny splat
import { GG, Ri, Ro, hOf, uOf, rampCands, groundOK, buildGugg, hangGugg } from './gugg.js'; // Guggenheim New York: rotunda + spiral ramp
//#endif
import { lavaTexture, TIER, HIGH, MEDIUM, LOW, nextTier, makeRenderer, PBR, setupEnvironment, exempt, exemptMaterial, makePipeline, setTier, haloMaterial, glowStripMaterial, makeAdaptive } from './look.js';
const GLOWS = []; // Medium's cheap bloom halos (also switched on if High steps down)
import { splatTex, plaqueTex, poolTex, stoneTex, metalTex, woodTex, flagTex, lavaTex } from './pixels.js';

const BASE = import.meta.env.BASE_URL;
const canvas = document.getElementById('c');
const renderer = makeRenderer(canvas); // native resolution, DPR capped per quality tier (see look.js)
const W = innerWidth, H = innerHeight;
const scene = new THREE.Scene();
//#if play
scene.background = new THREE.Color(0x0c0a08);
//#elif orsay
scene.background = new THREE.Color(0xe8e0d2);
//#elif bilbao
scene.background = new THREE.Color(0xc9dbe8); // Bilbao sky
//#elif uffizi
scene.background = new THREE.Color(0xcfdde6); // Tuscan sky
//#elif gugg-ny splat
scene.background = new THREE.Color(0xdfe8ee); // Manhattan sky (only seen through the skylight)
//#endif
setupEnvironment(renderer, scene);
//#if play orsay
const camera = new THREE.PerspectiveCamera(70, W / H, 0.05, 100);
//#elif bilbao uffizi gugg-ny splat
const camera = new THREE.PerspectiveCamera(70, W / H, 0.05, 600); // far enough for the river view
//#endif
camera.position.set(CATALOG.layout.start.x, 1.6, CATALOG.layout.start.z);
//#if play
camera.lookAt(CATALOG.layout.start.x + Math.sin(CATALOG.layout.start.yaw) * 5, 1.6 + Math.tan(CATALOG.layout.start.pitch || 0) * 5, CATALOG.layout.start.z + Math.cos(CATALOG.layout.start.yaw) * 5); // TJ's start view: travels hall, behind the hologram, facing the mural
//#elif orsay bilbao uffizi gugg-ny splat
camera.lookAt(CATALOG.layout.start.x + Math.sin(CATALOG.layout.start.yaw) * 5, 1.6, CATALOG.layout.start.z + Math.cos(CATALOG.layout.start.yaw) * 5);
//#endif
scene.add(camera);
const EYE = 1.6;
// raised dais in the centre with one step around it
const MINI = []; // small one-step daises under the room holograms
//#if play orsay bilbao uffizi
const floorH = (x, z) => { const dx = Math.abs(x - DAIS.x), dz = Math.abs(z - DAIS.z); if (dx < 1.8 && dz < 1.8) return 0.5; if (dx < 2.4 && dz < 2.4) return 0.25;
//#elif gugg-ny splat
// Guggenheim: the floor is the spiral ramp itself. At any (x, z) there is one candidate height per ramp turn (plus the
// rotunda floor, the galleries and the daises); the player's current floor height (curH) picks the turn, and a step is
// only allowed if it changes height by less than 0.6 m, so parapets, the ramp edge and the turns above/below all block.
let curH = 0;
const groundAt = (x, z) => { const dx = Math.abs(x - DAIS.x), dz = Math.abs(z - DAIS.z); if (dx < 1.8 && dz < 1.8) return 0.5; if (dx < 2.4 && dz < 2.4) return 0.25;
//#endif
  for (const m of MINI) if (Math.abs(x - m.x) < 1.4 && Math.abs(z - m.z) < 1.4) return 0.25; return 0; };
//#if play
scene.add(new THREE.HemisphereLight(0xd0b292, 0x46362a, 0.85));
//#elif orsay bilbao uffizi
scene.add(new THREE.HemisphereLight(0xfff4e4, 0xb4a488, 1.7)); // soft daylight
//#elif gugg-ny splat
function floorCands(x, z) { const out = rampCands(x, z); if (groundOK(x, z) || flatWalk(x, z)) out.push(groundAt(x, z)); return out; }
const nearestH = (c, ref) => { let b = null, bd = 1e9; for (const h of c) { const d = Math.abs(h - ref); if (d < bd) { bd = d; b = h; } } return b; };
const floorNear = (x, z, ref) => { const h = nearestH(floorCands(x, z), ref); return h === null ? 0 : h; };
const floorH = (x, z) => floorNear(x, z, curH);
scene.add(new THREE.HemisphereLight(0xfff4e4, 0xb4a488, 1.7)); // soft daylight
//#endif

