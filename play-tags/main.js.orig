    const mat = y0 > 0 ? MAT.metal(len / 2, hh / 2) : MAT.stone(len / 2, hh / 2);
    if (horiz) box(len, hh, WT, mat, mid, y0 + hh / 2, c - inward[1] * off); else box(WT, hh, len, mat, c - inward[0] * off, y0 + hh / 2, mid);
//#if play
    if (y0 === 0) { // lava channel + metal lip along the foot of solid wall
//#elif orsay bilbao uffizi gugg-ny splat
    if (false) { // (Orsay: no lava channel) + metal lip along the foot of solid wall
//#endif
      const lv = new THREE.Mesh(new THREE.PlaneGeometry(len, 0.2), lavaMat); lv.rotation.x = -Math.PI / 2;
      if (horiz) lv.position.set(mid, 0.015, c + inward[1] * 0.12); else { lv.rotation.z = Math.PI / 2; lv.position.set(c + inward[0] * 0.12, 0.015, mid); }
