function updateFall(dt) {
  fall.t += dt; fall.v -= 9.8 * dt; camera.position.y += fall.v * dt;
//#if play
  if (camera.position.y < 0.1) { // lava: straight into the hyperspace realm, then back in front of the gate
    const f = fall; fall = null; pendingChaos = false; chaosActive = true; document.body.classList.add('chaos'); say('THE LAVA IS NOT LAVA', 3);
//#elif orsay
  if (camera.position.y < 0.1) { // floor: straight into the hyperspace realm, then back in front of the gate
    const f = fall; fall = null; pendingChaos = false; chaosActive = true; document.body.classList.add('chaos'); say('THE FLOOR IS NOT A FLOOR', 3);
//#elif bilbao
  if (camera.position.y < 0.1) { // floor: straight into the hyperspace realm, then back in front of the gate
    const f = fall; fall = null; pendingChaos = false; chaosActive = true; document.body.classList.add('chaos'); say('THE ATRIUM FLOOR IS NOT A FLOOR', 3);
//#elif uffizi
  if (camera.position.y < 0.1) { // floor: straight into the hyperspace realm, then back in front of the gate
    const f = fall; fall = null; pendingChaos = false; chaosActive = true; document.body.classList.add('chaos'); say('THE TRIBUNA FLOOR IS NOT A FLOOR', 3);
//#elif gugg-ny splat
  if (camera.position.y < 0.1) { // floor: straight into the hyperspace realm, then back in front of the gate
    const f = fall; fall = null; pendingChaos = false; chaosActive = true; document.body.classList.add('chaos'); say('THE ROTUNDA FLOOR IS NOT A FLOOR', 3);
//#endif
