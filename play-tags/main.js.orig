// ---- Orsay re-plan: the old courtyard opens into a grand nave; the Travels gallery moves 8 m north to make room.
// Every work keeps its wall, order and spacing (whole rooms move, nothing is re-hung). Courtyard windows become doorways.
{ const L0 = CATALOG.layout, DZ = 8, T = L0.rooms.find(r => r.id === 'travels');
  T.minZ += DZ; T.maxZ += DZ; T.openings = T.openings.filter(o => o.wall !== 'W' && o.wall !== 'E');
  CATALOG.paintings.forEach(p => { if (p.room === 'travels') p.z += DZ; });
  (CATALOG.plaques || []).forEach(p => { if (p.room === 'travels') p.z += DZ; });
  (L0.groupSigns || []).forEach(s => { if (Math.abs(s.x) < 12.7 && s.z > 15) s.z += DZ; });
  L0.signs = L0.signs.filter(s => !(Math.abs(s.x) < 13 && s.z > 15));
  L0.hallways = L0.hallways.filter(h => h.minZ < 15);
  L0.rooms.forEach(r => { (r.windows || []).forEach(w => r.openings.push({ wall: w.wall, from: w.from, to: w.to, nave: 1 })); r.windows = []; });
  L0.nave = { minX: -15.225, maxX: 15.225, minZ: 12, maxZ: 15.5 + DZ };
  L0.start = { x: 11, z: 17.75, yaw: -Math.PI / 2 };
  // TJ's feedback: paintings in the main hall too. Shrink the side galleries (rooms stay roughly equal), hang the overflow
  // on the nave walls in wall order, and the Friends Club mural high on the nave's north wall as the centrepiece.
  const anchor = s => { let best = null, bd = 1e9; CATALOG.paintings.forEach(p => { if (Math.abs(Math.atan2(p.ix, p.iz) - s.yaw) > 0.1 && Math.abs(Math.abs(Math.atan2(p.ix, p.iz) - s.yaw) - Math.PI * 2) > 0.1) return; const d = Math.hypot(p.x - s.x, p.z - s.z); if (d < bd) { bd = d; best = p; } }); return best; };
  (L0.groupSigns || []).forEach(s => { s.anchor = anchor(s); });
  /* TJ: mural between the slipgates on the Travels N wall; gates keep their original 17.6 m spacing */
  const T0 = L0.rooms.find(r => r.id === 'travels'); // one Travels doorway closes so the mural gets a full wall
  window.__rehang = rehang(CATALOG, { nave: L0.nave, mural: { room: 'travels', wall: 'N', x: (L0.gate.to + L0.checkout.from) / 2, z: T0.maxZ - 0.035, y: 1.75, ix: 0, iz: -1 }, largest: 28, keepTogether: ['honeybadger-and-cub-with-genesis-block', 'coined-in-watercolor-film-poster', 'warszawska-syrenka'], shrink: [['central', 'S', 2], ['people', 'W', 3], ['archive', 'E', 4]],
