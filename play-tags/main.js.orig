//#elif bilbao
move.setFloorMaterial((x, z) => { const inB = (b, m) => b && x > b.minX - m && x < b.maxX + m && z > b.minZ - m && z < b.maxZ + m; if (floorH(x, z) > 0) return 'marble'; if (inB(L.fish, 0)) return 'concrete'; if (inB(NV, 0)) return 'stone'; return 'wood'; }); // floor tags for footsteps (museum-move)
//#elif uffizi
move.setFloorMaterial((x, z) => { const inB = (b, m) => b && x > b.minX - m && x < b.maxX + m && z > b.minZ - m && z < b.maxZ + m; if (floorH(x, z) > 0 || inB(NV, 0)) return 'marble'; for (const c of L.corr) if (inB(c, 0)) return 'marble'; return 'stone'; }); // floor tags for footsteps (museum-move)
//#elif gugg-ny splat
// Guggenheim floors for the footsteps: terrazzo rotunda floor (polished), ramp concrete, steel lift bridge, oak side galleries, stone halls
