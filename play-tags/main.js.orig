  const ops = room.openings.filter(o => o.wall === side).sort((p, q) => p.from - q.from);
  const cuts = [...ops.map(o => ({ ...o, door: 1 })), ...(room.windows || []).filter(w => w.wall === side)].sort((p, q) => p.from - q.from);
