  const t = e.changedTouches[0]; if (!lookTouch) return;
  const eu = new THREE.Euler(0, 0, 0, 'YXZ').setFromQuaternion(camera.quaternion);
  eu.y -= (t.clientX - lookTouch.clientX) * 0.005; eu.x = Math.max(-1.4, Math.min(1.4, eu.x - (t.clientY - lookTouch.clientY) * 0.005));
  camera.quaternion.setFromEuler(eu); lookTouch = t;
}, { passive: true });
