function drawWeapon() {
  vm.forEach((g, i) => g.visible = i === weapon);
  const g = vm[weapon], sw = Math.sin(performance.now() / 160) * Math.min(1, vel.length()) * 0.015;
  g.position.set(0.24 + sw, -0.24 - Math.abs(sw) + recoil * 0.03, -0.62 + recoil * 0.08); g.rotation.x = recoil * 0.25;
  if (weapon === 0) { g.rotation.x = 0; g.rotation.z = 0; thermosPose(g, fling / FLING_TIME); } // thermos: upright, fling on throw
  if (weapon === 1 && g.userData.beam) { scanFlash = Math.max(0, scanFlash - 0.03); g.userData.beam.material.opacity = 0.4 + 0.15 * Math.random() + scanFlash * 0.45; g.userData.beam.material.color.setHex(scanFlash > 0.3 ? 0x40ff70 : (shopScan && shopScan.beamColor()) || 0xff2010); }
  if (weapon === 2) { g.rotation.x = 0; g.rotation.z = 0; gravPose(g, performance.now() / 1000, !!(grav && grav.held), grav ? grav.kick : 0); }
  if (tools) tools.pose(g, weapon);
}
