let clockT = 0, ride = null, rideCool = 0;
// glass lift in the rotunda well: from the rotunda floor up to the top turn (then walk down the ramp, as Wright intended),
// and back down from the bridge at the top. Wall-clock timed.
function updateLifts(dt) {
