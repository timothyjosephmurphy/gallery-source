    x.fillStyle = '#17110c'; x.fillRect(0, 0, 620, 820); x.fillStyle = '#f2e4c4'; x.font = 'bold 40px Georgia, serif'; let y = 60;
    for (const l of wrapText(x, q.title, 560).slice(0, 3)) { x.fillText(l, 30, y); y += 46; }
    x.font = '24px Arial, sans-serif'; x.fillStyle = '#d2b47a'; if (q.lines[0]) { x.fillText(fit(x, q.lines[0], 560), 30, y); y += 44; }
    x.font = '25px Georgia, serif'; x.fillStyle = '#e6d6b4';
    for (const para of q.lines.slice(1)) { for (const l of wrapText(x, para, 560)) { if (y > 740) break; x.fillText(l, 30, y); y += 32; } y += 14; }
    x.font = '22px Arial, sans-serif'; x.fillStyle = '#d2b47a'; x.fillText('Press E to read more on tjm.art', 30, 790);
