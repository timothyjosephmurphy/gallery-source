const SOUP_BLOB = soupBlob();
//#if play
function throwSoup() { // throws a blob of smooth tomato soup
//#elif orsay bilbao uffizi gugg-ny splat
function throwPaint() { // throws a chunky blob of tomato soup
//#endif
  const dir = new THREE.Vector3(); camera.getWorldDirection(dir);
  const m = SOUP_BLOB.clone(); m.rotation.set(Math.random() * 6, Math.random() * 6, 0); sloshSound(() => holo.muted);
  m.position.copy(camera.position).addScaledVector(dir, 0.3).y -= 0.03;
  scene.add(m); balls.push({ m, v: dir.multiplyScalar(14), life: 3 });
}
let hitCount = 0, swarm = null; const hitSet = new Set(); // distinct paintings hit since last swarm
const SPLAT_GEO = (() => { const g = new THREE.PlaneGeometry(0.9, 1.125); g.translate(0, -(1.125 / 2 - 0.45), 0); return g; })();
function splat(hit) {
  const p = hit.object.userData.p;
  // decal: 4 mm proud of the canvas (painting sits at z 0.02), polygon offset, no depth write, drawn after the canvas,
  // and in the true-colour layer with the painting (no AO, haze, fog or tone mapping), so it can't z-fight or vanish on any tier
  splashSound(() => holo.muted);
  const mat = new THREE.MeshBasicMaterial({ map: soupSplatTex(), transparent: true, depthWrite: false, polygonOffset: true, polygonOffsetFactor: -4, polygonOffsetUnits: -4 });
  // 256x320 liquid texture: blob centre sits at the hit point, drips run straight down (no random roll, gravity wins);
  // pops in over 0.18 s; mirrored with scale.x for variety
  const d = new THREE.Mesh(SPLAT_GEO, mat);
  const local = p.group.worldToLocal(hit.point.clone());
  d.position.set(local.x, local.y, 0.024); d.scale.x = Math.random() < 0.5 ? -1 : 1; d.renderOrder = 5;
  mat.alphaTest = 0.02;
  p.group.add(d); exempt(d);
  const elves = [];
  const n = 2 + (Math.random() < 0.5 ? 1 : 0);
  for (let k = 0; k < n; k++) {
    const s = makeElf(Math.random());
    const side = ['L', 'R', 'T'][k], hw = p.w / 2, hh = p.h / 2;
    // hide inside the stone jambs / lintel of the niche, peek out into the niche
    const hide = side === 'L' ? new THREE.Vector3(-hw + 0.05, local.y, 0.05) : side === 'R' ? new THREE.Vector3(hw - 0.05, local.y, 0.05) : new THREE.Vector3(local.x, hh - 0.05, 0.05);
    const peek = side === 'L' ? new THREE.Vector3(-hw - 0.2, local.y, 0.35) : side === 'R' ? new THREE.Vector3(hw + 0.2, local.y, 0.35) : new THREE.Vector3(local.x, hh + 0.2, 0.35);
    Object.assign(s.userData, { a: k * 2.1, base: local.clone(), hide, peek });
    s.position.copy(hide); s.visible = false; p.group.add(s); elves.push(s);
  }
  trackSplat(p.data.slug); // anonymous per-painting splat count (paintings only; walls never reach splat())
  hitSet.add(p.data.slug); hitCount++; document.getElementById('hitn').textContent = hitSet.size % 3;
  const sp = { d, elves, group: p.group, t: 0, dur: 8 };
  if (hitSet.size >= 3) { hitSet.clear(); document.getElementById('hitn').textContent = 0; sp.swarm = true; sp.dur = 1e9; elves.forEach(e => e.visible = false); }
  splats.push(sp);
  say(sp.swarm ? 'SPLAT! ...SOMETHING STIRS BEHIND THE WALLS' : 'SPLAT!');
}

// buy tool + cart
const cart = [];
const cartEl = document.getElementById('cart'), cartList = document.getElementById('cartlist');
let cartT = 0;
function showCart(ms = 4000) { cartEl.classList.add('open'); clearTimeout(cartT); cartT = setTimeout(() => cartEl.classList.remove('open'), ms); }
function renderCart() {
  document.getElementById('cartn').textContent = cart.length;
  cartList.innerHTML = cart.length ? cart.map(d => `<li><a href="${d.url}" target="_blank" rel="noopener">${d.title}</a> · <i>In cart</i></li>`).join('') : '<li>empty</li>';
}
const lifts = [];
const scanTagTex = (() => { const c = document.createElement('canvas'); c.width = 256; c.height = 72; const x = c.getContext('2d'); x.fillStyle = '#12301c'; x.fillRect(0, 0, 256, 72); x.strokeStyle = '#3aff7a'; x.lineWidth = 5; x.strokeRect(3, 3, 250, 66);
  x.fillStyle = '#c8ffd8'; x.font = 'bold 34px Arial, sans-serif'; x.textAlign = 'center'; x.textBaseline = 'middle'; x.fillText('✓ Add to cart', 128, 38); const t = new THREE.CanvasTexture(c); t.colorSpace = THREE.SRGBColorSpace; return t; })();
let scanAC = null;
function scanBeep(ok) { if (holo.muted) return; try { scanAC = scanAC || new (window.AudioContext || window.webkitAudioContext)(); const a = scanAC, t = a.currentTime;
  (ok ? [[1568, 0], [2093, 0.09]] : [[330, 0]]).forEach(([f, d]) => { const o = a.createOscillator(), g = a.createGain(); o.type = ok ? 'sine' : 'triangle'; o.frequency.value = f; g.gain.setValueAtTime(0.0001, t + d); g.gain.linearRampToValueAtTime(0.035, t + d + 0.01); g.gain.exponentialRampToValueAtTime(0.0005, t + d + 0.12); o.connect(g).connect(a.destination); o.start(t + d); o.stop(t + d + 0.14); }); } catch (e) {} }
function scanGreen(p) { // the frame lights green with an 'Add to cart' tag
  const old = p.frame.material; p.frame.material = new THREE.MeshBasicMaterial({ color: 0x2bff6a }); exempt(p.frame);
  const tag = new THREE.Mesh(new THREE.PlaneGeometry(0.5, 0.14), new THREE.MeshBasicMaterial({ map: scanTagTex, transparent: true, depthWrite: false })); tag.position.set(0, p.h / 2 + 0.16, 0.04); p.group.add(tag); exempt(tag);
  scanBeep(true); scanFlash = 1; setTimeout(() => { p.frame.material.dispose(); p.frame.material = old; p.group.remove(tag); tag.geometry.dispose(); tag.material.dispose(); }, 1600); }
let scanFlash = 0, shopScan = null;
const printItem = (d, pr) => ({ slug: pr.id, status: 'available', kind: 'print', title: d.title + ' — ' + pr.size + ', ' + pr.frame + ' frame', url: d.url });
function buyPrint(a) { // #235: scanning a floating print preview adds that print (not the original)
  const pr = a.entry, d = a.p.data;
  if (cart.some(c => c.slug === pr.id)) { scanBeep(false); return say('THIS PRINT IS ALREADY IN YOUR CART'); }
  scanBeep(true); scanFlash = 1; cart.push(printItem(d, pr)); renderCart(); showCart();
  say('PRINT ADDED TO CART: ' + d.title);
}
function buy() {
  { const pa = shopScan && shopScan.printAt(hitTargets()); if (pa) return buyPrint(pa); }
  const hit = aimHit(); if (!hit) return say('AIM AT A PAINTING');
  const p = hit.object.userData.p;
  if (p.data.status === 'sold') { scanBeep(false); return say('SOLD: ' + p.data.title); }
  if (p.data.status !== 'available') { scanBeep(false); return say('BY INQUIRY ONLY: ' + p.data.title); }
  scanGreen(p); p.state = 'scanned'; setTimeout(() => { const from = p.group.position.clone(), rot = p.group.rotation.y; if (window.eggs && window.eggs.takePainting && window.eggs.takePainting(p, () => lifts.push({ p, t: 99, from, rot }))) return; p.state = 'lifting'; lifts.push({ p, t: 0, from, rot }); }, 650);
  cart.push(p.data); renderCart(); showCart();
  say('ADDED TO CART: ' + p.data.title);
}

// E: open the aimed painting's (or plaque's) page on tjm.art
const OPEN_DIST = 2.2;
function openTarget(ndc) {
  camera.updateMatrixWorld(); ray.setFromCamera(ndc || new THREE.Vector2(0, 0), camera); ray.far = OPEN_DIST;
  const h = ray.intersectObjects([...hitTargets(), ...boards], false)[0]; ray.far = Infinity;
  if (!h) { if (!ndc) say('GET CLOSER TO A PAINTING, THEN PRESS E'); return false; }
  const d = h.object.userData.p ? h.object.userData.p.data : h.object.userData.q;
  leaveTo(d); return true;
}
// leave the dungeon for a product page in the same tab; the page offers "Back to the Dungeon" (/play/?resume=1)
function leaveTo(d) {
  saveState();
  say('OPENING ' + d.title.toUpperCase()); if (controls.isLocked) controls.unlock();
  const u = new URL(d.url); u.searchParams.set('from', 'play'); top.location.assign(u.href);
}
// mobile: a short tap (no drag) on a painting within ~2 m opens it; the FIRE button shoots
let tapStart = null;
canvas.addEventListener('touchstart', e => { const t = e.changedTouches[0]; tapStart = { x: t.clientX, y: t.clientY, t: performance.now() }; }, { passive: true });
canvas.addEventListener('touchend', e => {
  const t = e.changedTouches[0]; if (!tapStart || swarm || chaosActive || fall || window.__reading) return;
  if (Math.hypot(t.clientX - tapStart.x, t.clientY - tapStart.y) > 12 || performance.now() - tapStart.t > 350) return;
  const r = canvas.getBoundingClientRect(); const ndc = new THREE.Vector2((t.clientX - r.left) / r.width * 2 - 1, -((t.clientY - r.top) / r.height) * 2 + 1); if (books.tryOpen(ndc)) return; openTarget(new THREE.Vector2((t.clientX - r.left) / r.width * 2 - 1, -((t.clientY - r.top) / r.height) * 2 + 1));
}, { passive: true });
// "Go to a painting" (as on tjm.art/gallery/room): teleport in front of a work
const gotoSel = document.getElementById('goto');
//#if play
gotoSel.innerHTML = '<option value="">Go to a painting…</option>' + ROOMS.map(r => `<optgroup label="${esc(r.title)}">` + paintings.filter(p => p.room === r.id).map(p => `<option value="${p.i}">${esc(p.data.title)}</option>`).join('') + '</optgroup>').join('');
//#elif orsay
gotoSel.innerHTML = '<option value="">Go to a painting…</option>' + [{ id: 'nave', title: 'The Nave' }, ...ROOMS].map(r => `<optgroup label="${esc(r.title)}">` + paintings.filter(p => p.room === r.id).map(p => `<option value="${p.i}">${esc(p.data.title)}</option>`).join('') + '</optgroup>').join('');
//#elif bilbao
gotoSel.innerHTML = '<option value="">Go to a painting…</option>' + [{ id: 'nave', title: 'Atrium' }, { id: 'fish', title: 'Gallery 104 · The Fish' }, ...ROOMS].map(r => `<optgroup label="${esc(r.title)}">` + paintings.filter(p => p.room === r.id).map(p => `<option value="${p.i}">${esc(p.data.title)}</option>`).join('') + '</optgroup>').join('');
//#elif uffizi
gotoSel.innerHTML = '<option value="">Go to a painting…</option>' + [{ id: 'nave', title: 'The Tribuna' }, { id: 'fish', title: 'The Corridors' }, ...ROOMS].map(r => `<optgroup label="${esc(r.title)}">` + paintings.filter(p => p.room === r.id).map(p => `<option value="${p.i}">${esc(p.data.title)}</option>`).join('') + '</optgroup>').join('');
//#elif gugg-ny splat
gotoSel.innerHTML = '<option value="">Go to a painting…</option>' + [ROT, ...ROOMS].map(r => `<optgroup label="${esc(r.title)}">` + paintings.filter(p => p.room === r.id).map(p => `<option value="${p.i}">${esc(p.data.title)}</option>`).join('') + '</optgroup>').join('');
//#endif
['click', 'mousedown', 'touchstart'].forEach(ev => gotoSel.addEventListener(ev, e => e.stopPropagation()));
{ const hb = document.createElement('a'); hb.id = 'homebtn'; hb.href = 'https://tjm.art/'; hb.setAttribute('aria-label', 'Back to the tjm.art homepage'); hb.title = 'Back to tjm.art';
  hb.innerHTML = '<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M12 3 2 12h3v8h5v-5h4v5h5v-8h3z"/></svg><span>Home</span>';
  document.body.appendChild(hb);
  const goHome = e => { e.stopPropagation(); e.preventDefault(); window.__wentHome = true; try { saveState(); } catch (x) {} top.location.href = 'https://tjm.art/'; };
  [hb, document.getElementById('homelink')].forEach(el => { if (!el) return; el.addEventListener('click', goHome);
    ['mousedown', 'pointerdown', 'mouseup', 'pointerup', 'touchstart', 'touchend'].forEach(ev => el.addEventListener(ev, e => e.stopPropagation(), { passive: true })); }); }
function goTo(i) {
  const p = paintings[i]; if (!p || p.state !== 'wall') return;
  const n = new THREE.Vector3(p.data.ix, 0, p.data.iz), d = Math.max(1.8, Math.min(4, p.h * 1.3 + 0.8));
//#if play orsay bilbao uffizi
  camera.position.copy(p.group.position).addScaledVector(n, d); camera.position.y = EYE + floorH(camera.position.x, camera.position.z);
  camera.lookAt(p.group.position.x, Math.min(p.group.position.y, EYE + 0.4), p.group.position.z);
//#elif gugg-ny splat
  camera.position.copy(p.group.position).addScaledVector(n, d); curH = floorNear(camera.position.x, camera.position.z, p.group.position.y - 1.7); camera.position.y = EYE + curH;
  camera.lookAt(p.group.position.x, Math.min(p.group.position.y, curH + EYE + 0.4), p.group.position.z);
//#endif
  const eu = new THREE.Euler(0, 0, 0, 'YXZ').setFromQuaternion(camera.quaternion); eu.z = 0; camera.quaternion.setFromEuler(eu);
  vel.set(0, 0, 0); updateNearby(); say(p.data.title.toUpperCase());
}
gotoSel.addEventListener('change', () => { if (gotoSel.value === '') return; goTo(+gotoSel.value); gotoSel.value = '';
  if (matchMedia('(pointer:coarse)').matches) start.style.display = 'none'; else controls.lock(); });

// ---- labels: sharp HTML overlay, sized to the world, faded with distance ----
const _v = new THREE.Vector3();
function updateLabels() {
  const cp = camera.position, rect = canvas.getBoundingClientRect(), cur = roomAt(cp.x, cp.z).id;
  const f = rect.height / 2 / Math.tan(THREE.MathUtils.degToRad(camera.fov / 2)), hide = chaosActive || (swarm && swarm.locked);
  for (const l of LABELS) {
    const d = l.pos.distanceTo(cp), far = l.cls === 'board' ? 5 : 6.5;
    let ok = !hide && d < far && (cp.x - l.pos.x) * l.n.x + (cp.z - l.pos.z) * l.n.z > 0.25 && l.room === cur && (!l.p || l.p.state === 'wall');
    if (ok) { _v.copy(l.pos).project(camera); ok = _v.z < 1 && Math.abs(_v.x) < 1.2 && Math.abs(_v.y) < 1.2; }
    if (!ok) { if (l.shown) { l.el.style.display = 'none'; l.shown = false; } continue; }
    if (!l.shown) { l.el.style.display = 'block'; l.shown = true; }
    const k = f / d; // px per metre at this distance
    l.el.style.left = (rect.left + (_v.x + 1) / 2 * rect.width) + 'px'; l.el.style.top = (rect.top + (1 - _v.y) / 2 * rect.height) + 'px';
    // sized in world units so a label never grows past its clear band under the frame
    l.el.style.width = (l.w * k) + 'px'; l.el.style.fontSize = Math.min(30, k * (l.cls === 'board' ? 0.034 : 0.07)) + 'px';
    l.el.style.opacity = Math.min(1, (far - d) / 2.5).toFixed(2);
  }
}

// ---- swarm: every 3rd hit ----
const V = (x, y, z) => new THREE.Vector3(x, y, z);
const lerpV = (a, b, x) => a.clone().lerp(b, Math.min(1, Math.max(0, x)));
const ease = x => { x = Math.min(1, Math.max(0, x)); return x * x * (3 - 2 * x); };
function startSwarm(drag) {
  splats.forEach(s => s.inSwarm = true);
  const elves = []; // TJ: no freeze any more: you keep moving and the elves chase you down
  const room = roomAt(camera.position.x, camera.position.z);
  const src = (() => { // elves come out of paintings behind or beside you: skip those within ~60° of where you look and nearer than 10 m in front
    const yw = new THREE.Euler(0, 0, 0, 'YXZ').setFromQuaternion(camera.quaternion).y, fx = -Math.sin(yw), fz = -Math.cos(yw), c = camera.position;
    const all = paintings.filter(p => p.state === 'wall' && p.room === room.id).sort((a, b) => a.dist - b.dist);
    const ahead = p => { const dx = p.group.position.x - c.x, dz = p.group.position.z - c.z, dd = Math.hypot(dx, dz) || 1; return dd < 10 && (dx * fx + dz * fz) / dd > 0.5; };
    const ok = all.filter(p => !ahead(p)); return (ok.length >= 3 ? ok : [...ok, ...all.filter(ahead)]).slice(0, 8); })();
  src.forEach(p => { p.group.visible = true;
    for (let k = 0; k < 4; k++) {
      const hw = p.w / 2, hh = p.h / 2, side = k % 3;
      const yy = (Math.random() - 0.5) * p.h * 0.8, xx = (Math.random() - 0.5) * p.w * 0.8;
      const home = p.group.localToWorld(side === 2 ? V(xx, hh - 0.05, 0.05) : V(side ? hw - 0.05 : -hw + 0.05, yy, 0.05));
      const peek = p.group.localToWorld(side === 2 ? V(xx, hh + 0.3, 0.45) : V(side ? hw + 0.28 : -hw - 0.28, yy, 0.45));
      const s = makeElf(Math.random()); s.position.copy(home); scene.add(s);
      const a = Math.random() * Math.PI * 2, rad = 0.7 + Math.random() * 0.7;
      elves.push({ s, home, peek, a, rad, dy: -0.55 - Math.random() * 0.5, ph: Math.random() * 6, j: k });
    }
  });
//#if play orsay bilbao uffizi
  const dest = room.id === 'central' ? V(DAIS.x, 0, DAIS.z) : V((room.minX + room.maxX) / 2, 0, (room.minZ + room.maxZ) / 2);
  swarm = { t: 0, elves, locked: false, chase: true, drag: !!drag, ct: 0, trail: [], trailT: 0, from: camera.position.clone(), dest, landed: false, shake: 0 };
//#elif gugg-ny splat
  const dest = room.id === 'central' ? (curH > 0.3 ? V(camera.position.x, 0, camera.position.z) : V(DAIS.x, 0, DAIS.z)) : V((room.minX + room.maxX) / 2, 0, (room.minZ + room.maxZ) / 2);
  swarm = { fromH: curH, destH: curH > 0.3 ? curH : 0, t: 0, elves, locked: false, chase: true, drag: !!drag, ct: 0, trail: [], trailT: 0, from: camera.position.clone(), dest, landed: false, shake: 0 };
//#endif
  say('THE ELVES HAVE OPINIONS', 6);
}
// chase: elves run you down. They rubber-band (always faster than your top speed, faster still the further back they are)
// and hop onto your recent trail, out of sight, if a wall blocks them or they fall far behind. Once caught, the old carry plays.
const EMERGE = 2; // s: the elves climb out of the paintings before the chase starts (a fair head start)
function updateChase(dt) {
  const w = swarm; w.ct += dt; const t = w.ct, c = camera.position;
  w.trailT -= dt; if (w.trailT <= 0) { w.trailT = 0.25; w.trail.push(V(c.x, 0, c.z)); if (w.trail.length > 16) w.trail.shift(); }
  const yaw = new THREE.Euler(0, 0, 0, 'YXZ').setFromQuaternion(camera.quaternion).y, fwd = V(-Math.sin(yaw), 0, -Math.cos(yaw));
  let best = 1e9;
  w.elves.forEach((e, i) => {
    if (t < EMERGE) { const u = ease((t - i % 3 * 0.25) / (EMERGE - 0.5)); e.s.position.copy(lerpV(e.home, e.peek, u)); e.s.position.y += Math.sin(t * 9 + i) * 0.04 * (1 - u); e.s.scale.setScalar(Math.max(0.05, Math.min(1, t / (EMERGE * 0.8)))); animateElf(e.s, 'peek', t, camera, dt); e.cp = e.s.position.clone(); return; }
    if (move) { best = Math.min(best, move.chase.step(e, w, t - (EMERGE - 1), dt)); return; }
    const tx = c.x + Math.cos(e.a + yaw) * e.rad * 1.6, tz = c.z + Math.sin(e.a + yaw) * e.rad * 1.6;
    const d = Math.hypot(tx - e.cp.x, tz - e.cp.z) || 1, pd = Math.hypot(c.x - e.cp.x, c.z - e.cp.z);
    const sp = 7 + (t - 1) * 1.2 + Math.max(0, pd - 3) * 1.5, k = Math.min(1, sp * dt / d), nx = e.cp.x + (tx - e.cp.x) * k, nz = e.cp.z + (tz - e.cp.z) * k;
    if (walkable(nx, nz) || pd < 1.6) { e.cp.x = nx; e.cp.z = nz; e.stuck = 0; } else e.stuck = (e.stuck || 0) + dt;
    if (e.stuck > 0.25 || pd > 14) { const b = w.trail[Math.max(0, w.trail.length - 6)] || V(c.x, 0, c.z), ox = b.x - c.x, oz = b.z - c.z;
      if (ox * fwd.x + oz * fwd.z < 0 || e.stuck > 1.2) { e.cp.x = b.x + (Math.random() - 0.5) * 0.4; e.cp.z = b.z + (Math.random() - 0.5) * 0.4; e.stuck = 0; } }
//#if play orsay bilbao uffizi
    e.cp.y = 0.35 + Math.abs(Math.sin(t * 8 + e.ph)) * 0.2; e.s.position.copy(e.cp); e.s.scale.setScalar(1);
//#elif gugg-ny splat
    e.cp.y = curH + 0.35 + Math.abs(Math.sin(t * 8 + e.ph)) * 0.2; e.s.position.copy(e.cp); e.s.scale.setScalar(1);
//#endif
    animateElf(e.s, 'walk', t, camera, dt); best = Math.min(best, Math.hypot(c.x - e.cp.x, c.z - e.cp.z));
  });
  if (t > EMERGE && (best < 1.0 || (move ? move.chase.forceCatch(t - (EMERGE - 1)) : t > 13))) { if (move) move.chase.end(w); // caught: from here on it is the old sequence (lift, carry, drop)
//#if play orsay bilbao uffizi
    const r = roomAt(c.x, c.z); if (r) w.dest = r.id === 'central' ? V(DAIS.x, 0, DAIS.z) : V((r.minX + r.maxX) / 2, 0, (r.minZ + r.maxZ) / 2);
//#elif gugg-ny splat
    const r = roomAt(c.x, c.z); w.fromH = curH; w.destH = curH > 0.3 ? curH : 0; if (r) w.dest = r.id === 'central' ? (curH > 0.3 ? V(c.x, 0, c.z) : V(DAIS.x, 0, DAIS.z)) : V((r.minX + r.maxX) / 2, 0, (r.minZ + r.maxZ) / 2);
//#endif
    if (w.drag) { w.chase = false; w.caughtAt = t; w.locked = true; controls.enabled = false; vel.set(0, 0, 0); startDrag(w); if (move && move.hold) move.hold.begin(w, 'drag'); say('THEY HAVE YOUR ANKLES', 3); return; }
    w.chase = false; w.caughtAt = t; w.t = 2.2; w.from = c.clone(); w.locked = true; controls.enabled = false; vel.set(0, 0, 0); say('CAUGHT!', 2); if (move && move.hold) move.hold.begin(w, 'carry');
  }
}
// ---- 3rd summoning: drag to the slipgate along a grid path (A* over walkable cells, clear of pillars, daises and pedestals) ----
function dragPath(from, to) {
//#if play orsay bilbao uffizi
  const C = 0.5; let x0 = 1e9, x1 = -1e9, z0 = 1e9, z1 = -1e9; ROOMS.forEach(r => { x0 = Math.min(x0, r.minX); x1 = Math.max(x1, r.maxX); z0 = Math.min(z0, r.minZ); z1 = Math.max(z1, r.maxZ); });
//#elif gugg-ny splat
  const C = 0.5; let x0 = 1e9, x1 = -1e9, z0 = 1e9, z1 = -1e9; [ROT, ...ROOMS].forEach(r => { x0 = Math.min(x0, r.minX); x1 = Math.max(x1, r.maxX); z0 = Math.min(z0, r.minZ); z1 = Math.max(z1, r.maxZ); });
//#endif
  x0 -= 12; z0 -= 12; x1 += 12; z1 += 12; const NX = Math.ceil((x1 - x0) / C), NZ = Math.ceil((z1 - z0) / C), cx = i => x0 + (i + 0.5) * C, cz = j => z0 + (j + 0.5) * C;
//#if play orsay bilbao uffizi
  const blocked = (x, z) => { for (const [dx, dz] of [[0, 0], [0.4, 0], [-0.4, 0], [0, 0.4], [0, -0.4]]) if (!walkable(x + dx, z + dz)) return true;
//#elif gugg-ny splat
  const blocked = (x, z) => { for (const [dx, dz] of [[0, 0], [0.4, 0], [-0.4, 0], [0, 0.4], [0, -0.4]]) if (!walkable(x + dx, z + dz, 0)) return true;
//#endif
    for (const [px, pz] of pillars) if (Math.abs(x - px) < 0.95 && Math.abs(z - pz) < 0.95) return true;
    for (const m of MINI) if (Math.abs(x - m.x) < 1.9 && Math.abs(z - m.z) < 1.9) return true;
